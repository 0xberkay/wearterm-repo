#!/bin/sh
# wt-battwatch - buzz and notify when charge crosses a threshold.
# Usage: wt-battwatch [-l low] [-i seconds]
# Runs until interrupted; alerts once per crossing, not once per poll.
set -eu

low=20
interval=300

while [ $# -gt 0 ]; do
  case "$1" in
    -l) low=${2:?-l needs a percentage}; shift 2 ;;
    -i) interval=${2:?-i needs seconds}; shift 2 ;;
    -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
    *) echo "wt-battwatch: unknown option: $1" >&2; exit 2 ;;
  esac
done

alerted=0

level() {
  # wt-battery -p prints the percentage on its own.
  wt-battery -p 2>/dev/null | tr -dc '0-9'
}

while :; do
  pct=$(level)
  if [ -n "$pct" ]; then
    if [ "$pct" -le "$low" ] && [ "$alerted" -eq 0 ]; then
      wt-vibrate -d 600 || true
      echo "Battery at ${pct}%" | wt-notify -t "Low battery" -i 1 || true
      alerted=1
    elif [ "$pct" -gt "$low" ]; then
      alerted=0
    fi
    printf '%s %s%%\n' "$(date '+%H:%M')" "$pct"
  fi
  sleep "$interval"
done
