#!/bin/sh
# wt-pomodoro - work/break cycles, each end marked by a buzz and a notification.
# Usage: wt-pomodoro [-w work_min] [-b break_min] [-r rounds]
set -eu

work=25
brk=5
rounds=4

while [ $# -gt 0 ]; do
  case "$1" in
    -w) work=${2:?-w needs minutes}; shift 2 ;;
    -b) brk=${2:?-b needs minutes}; shift 2 ;;
    -r) rounds=${2:?-r needs a count}; shift 2 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) echo "wt-pomodoro: unknown option: $1" >&2; exit 2 ;;
  esac
done

phase() {
  minutes=$1
  title=$2
  printf '%s for %s min\n' "$title" "$minutes"
  sleep $((minutes * 60))
  wt-vibrate -d 500 || true
  echo "$title done" | wt-notify -t "Pomodoro" -i 3 || true
}

round=1
while [ "$round" -le "$rounds" ]; do
  printf -- '--- round %s/%s ---\n' "$round" "$rounds"
  phase "$work" "Focus"
  [ "$round" -lt "$rounds" ] && phase "$brk" "Break"
  round=$((round + 1))
done

wt-tts "All rounds finished" || true
